# Скопируй в .envrc и заполни. .envrc в .gitignore — секреты в git не попадают.
# Требует direnv: `brew install direnv`, затем `direnv allow`.

# --- AWS (деплой Lambda / S3 / CloudFront) ---
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_DEFAULT_REGION="eu-central-1"

# --- Cloudflare (DNS зоны vsluh.club) ---
export CLOUDFLARE_API_TOKEN=""
export CLOUDFLARE_ACCOUNT_ID=""
export CLOUDFLARE_ZONE_ID=""

# --- GitHub (создание репозитория, Actions secrets) ---
export GITHUB_TOKEN=""

# --- Telegram ---
export TELEGRAM_BOT_TOKEN=""
